# MuxCore Emby module — Environment Variables
# Copy to .env and adjust for your environment.

# Core connection
# MUXCORE_GRPC_ADDR=localhost:9090
# MUXCORE_INSECURE_DISABLE_TLS=true
# MUXCORE_MODULE_ID=emby

# Listen addresses
# EMBY_GRPC_ADDR=:9477
# EMBY_HTTP_ADDR=:8477

# Emby server
# EMBY_URL=http://emby:8096
# EMBY_TOKEN=

# Durable admin settings (URL, token, SSE secret, poll/websocket/catalog knobs)
# EMBY_DATA_DIR=/var/lib/muxcore-emby

# Playback
# EMBY_SESSIONS_POLL_SEC=30
# EMBY_WEBSOCKET=1

# SSE ingest auth — required for POST /emby/sse/events (X-Emby-SSE-Secret or Authorization: Bearer)
# EMBY_SSE_SECRET=

# Library catalog full sync interval in seconds (default 21600 = 6h)
# EMBY_CATALOG_SYNC_SEC=21600
